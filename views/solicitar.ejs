<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Formulário para solicitar o empréstimo de material hospitalar."
    />
    <title>Solicitar empréstimo | Comunidade 3 de Maio</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <nav
      class="navbar navbar-expand-lg site-navbar sticky-top"
      aria-label="Navegação principal"
    >
      <div class="container">
        <a class="navbar-brand site-logo" href="index.ejs"
          ><i class="bi bi-heart-pulse me-2" aria-hidden="true"></i>3 de Maio</a
        ><button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#menuPrincipal"
          aria-controls="menuPrincipal"
          aria-expanded="false"
          aria-label="Abrir menu"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menuPrincipal">
          <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
            <li class="nav-item">
              <a class="nav-link" href="index.ejs">Início</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="materiais.ejs">Materiais</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="solicitacoes.ejs"
                >Minhas solicitações</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" href="admin.ejs">Área administrativa</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>
    <main class="py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-12 col-xl-10">
            <section class="section-box p-4 p-md-5">
              <div class="form-heading mb-4">
                <div class="feature-icon">
                  <i class="bi bi-clipboard2-plus" aria-hidden="true"></i>
                </div>
                <div>
                  <span class="section-kicker">Nova solicitação</span>
                  <h1 class="h2 fw-bold mt-1 mb-1">
                    Solicitar material hospitalar
                  </h1>
                  <p class="text-secondary mb-0">
                    Preencha seus dados para registrar o pedido.
                  </p>
                </div>
              </div>
              <div class="form-note mb-4">
                <i class="bi bi-shield-check me-2" aria-hidden="true"></i
                ><span
                  >Os campos marcados com <strong>*</strong> são
                  obrigatórios.</span
                >
              </div>
              <form id="formSolicitacao" class="row g-3" novalidate>
                <div class="col-12">
                  <label for="nome" class="form-label"
                    >Nome completo <span class="required">*</span></label
                  ><input
                    type="text"
                    id="nome"
                    class="form-control"
                    placeholder="Seu nome completo"
                    autocomplete="name"
                    required
                  />
                </div>
                <div class="col-md-6">
                  <label for="cpf" class="form-label"
                    >CPF <span class="required">*</span></label
                  ><input
                    type="text"
                    id="cpf"
                    class="form-control"
                    placeholder="000.000.000-00"
                    inputmode="numeric"
                    autocomplete="off"
                    required
                  />
                </div>
                <div class="col-md-6">
                  <label for="telefone" class="form-label"
                    >Telefone <span class="required">*</span></label
                  ><input
                    type="tel"
                    id="telefone"
                    class="form-control"
                    placeholder="(00) 00000-0000"
                    inputmode="tel"
                    autocomplete="tel"
                    required
                  />
                </div>
                <div class="col-12">
                  <label for="email" class="form-label"
                    >E-mail <span class="required">*</span></label
                  ><input
                    type="email"
                    id="email"
                    class="form-control"
                    placeholder="email@exemplo.com"
                    autocomplete="email"
                    required
                  />
                </div>
                <div class="col-md-7">
                  <label for="rua" class="form-label"
                    >Rua <span class="required">*</span></label
                  ><input
                    type="text"
                    id="rua"
                    class="form-control"
                    autocomplete="street-address"
                    required
                  />
                </div>
                <div class="col-md-5">
                  <label for="numero" class="form-label">Número</label
                  ><input
                    type="text"
                    id="numero"
                    class="form-control"
                    inputmode="numeric"
                  />
                </div>
                <div class="col-md-6">
                  <label for="bairro" class="form-label"
                    >Bairro <span class="required">*</span></label
                  ><input
                    type="text"
                    id="bairro"
                    class="form-control"
                    required
                  />
                </div>
                <div class="col-md-6">
                  <label for="cidade" class="form-label"
                    >Cidade <span class="required">*</span></label
                  ><input
                    type="text"
                    id="cidade"
                    class="form-control"
                    autocomplete="address-level2"
                    required
                  />
                </div>
                <div class="col-12">
                  <label for="complemento" class="form-label"
                    >Complemento
                    <span class="fw-normal text-secondary"
                      >(opcional)</span
                    ></label
                  ><input type="text" id="complemento" class="form-control" />
                </div>
                <div class="col-12">
                  <label for="material" class="form-label"
                    >Material hospitalar <span class="required">*</span></label
                  ><select id="material" class="form-select" required>
                    <option value="">Selecione um item...</option>
                  </select>
                </div>
                <div
                  class="col-12 d-flex flex-column flex-sm-row justify-content-end gap-2 pt-3"
                >
                  <a href="materiais.ejs" class="btn btn-outline-custom px-4"
                    >Voltar aos materiais</a
                  ><button type="submit" class="btn btn-primary-custom px-4">
                    <i class="bi bi-send me-2" aria-hidden="true"></i>Enviar
                    solicitação
                  </button>
                </div>
              </form>
            </section>
          </div>
        </div>
      </div>
    </main>
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
      <div
        id="successToast"
        class="toast"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        <div class="toast-header">
          <i
            class="bi bi-check-circle-fill text-success me-2"
            aria-hidden="true"
          ></i
          ><strong class="me-auto">Solicitação</strong
          ><button
            type="button"
            class="btn-close"
            data-bs-dismiss="toast"
            aria-label="Fechar"
          ></button>
        </div>
        <div class="toast-body">Solicitação enviada com sucesso!</div>
      </div>
    </div>
    <script src="/js/dados.js"></script>
    <script src="/js/solicitar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
