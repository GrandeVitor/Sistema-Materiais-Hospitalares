
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
        name="description"
        content="Consulte suas solicitações de empréstimo."
    />

    <title>Minhas solicitações | Comunidade 3 de Maio</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    />

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
    <nav
        class="navbar navbar-expand-lg site-navbar sticky-top"
        aria-label="Navegação principal"
    >
        <div class="container">
            <a class="navbar-brand site-logo" href="/">
                <i class="bi bi-heart-pulse me-2" aria-hidden="true"></i>
                3 de Maio
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal"
                aria-controls="menuPrincipal"
                aria-expanded="false"
                aria-label="Abrir menu"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">

                    <li class="nav-item">
                        <a class="nav-link" href="/">Início</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/materiais">
                            Materiais
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link active"
                            aria-current="page"
                            href="/solicitacoes"
                        >
                            Minhas solicitações
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/admin">
                            Área administrativa
                        </a>
                    </li>

                    <% if (usuarioLogado) { %>

                        <li class="nav-item">
                            <span class="nav-link">
                                Olá, <%= usuarioLogado.nome %>!
                            </span>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/usuarios/logout">
                                <i
                                    class="bi bi-box-arrow-right me-1"
                                    aria-hidden="true"
                                ></i>
                                Sair
                            </a>
                        </li>

                    <% } else { %>

                        <li class="nav-item">
                            <a class="nav-link" href="/usuarios/login">
                                <i
                                    class="bi bi-box-arrow-in-right me-1"
                                    aria-hidden="true"
                                ></i>
                                Entrar
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/usuarios/cadastro">
                                <i
                                    class="bi bi-person-plus me-1"
                                    aria-hidden="true"
                                ></i>
                                Criar conta
                            </a>
                        </li>

                    <% } %>

                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">

            <div class="page-header mb-4">
                <span class="section-kicker">Acompanhamento</span>

                <h1 class="fw-bold mt-1">
                    Minhas solicitações
                </h1>

                <p class="text-secondary mb-0">
                    Informe seu e-mail para consultar seus pedidos.
                </p>
            </div>

            <!-- Pesquisa por e-mail -->
            <form
                action="/solicitacoes/buscar"
                method="POST"
                class="search-box flex-grow-1 mb-4"
            >
                <div class="input-group input-group-lg">

                    <span class="input-group-text" aria-hidden="true">
                        <i class="bi bi-person-search"></i>
                    </span>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-control"
                        placeholder="Digite seu e-mail..."
                        value="<%= email %>"
                        required
                    />

                    <button type="submit" class="btn btn-primary-custom">
                        Consultar
                    </button>

                </div>
            </form>

            <!-- Lista de solicitações -->
            <div
                id="listaSolicitacoes"
                class="row row-cols-1 row-cols-lg-2 g-4 solicitacoes-lista"
                aria-live="polite"
            >

                <% if (!pesquisou) { %>

                    <div class="col-12">
                        <div class="empty-state text-center p-5">

                            <div class="feature-icon mx-auto mb-3">
                                <i
                                    class="bi bi-person-search"
                                    aria-hidden="true"
                                ></i>
                            </div>

                            <h2 class="h5 fw-bold">
                                Consulte uma solicitação
                            </h2>

                            <p class="text-secondary mb-0">
                                Digite seu e-mail acima para visualizar seus pedidos.
                            </p>

                        </div>
                    </div>

                <% } else if (solicitacoes.length === 0) { %>

                    <div class="col-12">
                        <div class="empty-state text-center p-5">

                            <div class="feature-icon mx-auto mb-3">
                                <i
                                    class="bi bi-inbox"
                                    aria-hidden="true"
                                ></i>
                            </div>

                            <h2 class="h5 fw-bold">
                                Nenhuma solicitação encontrada
                            </h2>

                            <p class="text-secondary mb-0">
                                Confira o e-mail informado e tente novamente.
                            </p>

                        </div>
                    </div>

                <% } else { %>

                    <% solicitacoes.forEach(item => { %>

                        <div class="col">
                            <div class="material-card">

                                <h3><%= item.material %></h3>

                                <img
                                    src="<%= item.imagem %>"
                                    class="material-img-right"
                                    alt="<%= item.material %>"
                                />

                                <p>
                                    <strong>Nome:</strong>
                                    <%= item.nomeUsuario %>
                                </p>

                                <p>
                                    <strong>Email:</strong>
                                    <%= item.email %>
                                </p>

                                <p>
                                    <strong>Solicitado em:</strong>
                                    <%= new Date(item.dataSolicitacao).toLocaleDateString('pt-BR') %>
                                </p>

                                <div class="status <%= item.status.toLowerCase() %>">
                                    <%= item.status.toUpperCase() %>
                                </div>

                            </div>
                        </div>

                    <% }); %>

                <% } %>

            </div>

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
