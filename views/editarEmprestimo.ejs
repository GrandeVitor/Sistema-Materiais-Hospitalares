<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar empréstimo | Comunidade 3 de Maio</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="container py-5">
      <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
          <div class="card shadow-sm border-0">
            <div class="card-body p-4">
              <h1 class="h3 fw-bold mb-2">Editar empréstimo</h1>
              <p class="text-secondary mb-4">
                Atualize os dados do empréstimo.
              </p>

              <form
                action="/admin/emprestimos/editar/<%= emprestimo._id %>"
                method="POST"
              >
                <div class="mb-3">
                  <label for="nomeUsuario" class="form-label">
                    Nome do usuário
                  </label>

                  <input
                    type="text"
                    id="nomeUsuario"
                    name="nomeUsuario"
                    class="form-control"
                    value="<%= emprestimo.nomeUsuario %>"
                    required
                  />
                </div>

                <div class="mb-3">
                  <label for="nomeMaterial" class="form-label">
                    Material
                  </label>

                  <input
                    type="text"
                    id="nomeMaterial"
                    class="form-control"
                    value="<%= emprestimo.nomeMaterial %>"
                    disabled
                  />
                </div>

                <div class="mb-3">
                  <label for="quantidade" class="form-label">
                    Quantidade
                  </label>

                  <input
                    type="number"
                    id="quantidade"
                    class="form-control"
                    value="<%= emprestimo.quantidade %>"
                    disabled
                  />
                </div>

                <div class="mb-3">
                  <label for="dataEmprestimo" class="form-label">
                    Data do empréstimo
                  </label>

                  <input
                    type="date"
                    id="dataEmprestimo"
                    name="dataEmprestimo"
                    class="form-control"
                    value="<%= new Date(emprestimo.dataEmprestimo).toISOString().split('T')[0] %>"
                    required
                  />
                </div>

                <div class="mb-4">
                  <label class="form-label">Status</label>

                  <input
                    type="text"
                    class="form-control"
                    value="<%= emprestimo.status %>"
                    disabled
                  />
                </div>

                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-primary-custom">
                    Salvar alterações
                  </button>

                  <a href="/admin" class="btn btn-secondary-custom">
                    Cancelar
                  </a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
