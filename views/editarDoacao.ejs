<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar doação | Comunidade 3 de Maio</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="container py-5">
      <div class="card shadow-sm mx-auto" style="max-width: 700px">
        <div class="card-header">
          <h1 class="h4 mb-0">Editar doação</h1>
        </div>

        <div class="card-body">
          <form
            action="<%= origemAdmin ? '/admin/doacoes/editar/' : '/doacoes/editar/' %><%= doacao._id %>"
            method="POST"
          >
            <div class="mb-3">
              <label for="nomeDoador" class="form-label">Nome do doador</label>
              <input
                type="text"
                class="form-control"
                id="nomeDoador"
                name="nomeDoador"
                value="<%= doacao.nomeDoador %>"
                required
              />
            </div>

            <div class="mb-3">
              <label for="nomeMaterial" class="form-label"
                >Material doado</label
              >
              <input
                type="text"
                class="form-control"
                id="nomeMaterial"
                name="nomeMaterial"
                value="<%= doacao.nomeMaterial %>"
                required
              />
            </div>

            <div class="mb-3">
              <label for="quantidade" class="form-label">Quantidade</label>
              <input
                type="number"
                class="form-control"
                id="quantidade"
                name="quantidade"
                min="1"
                value="<%= doacao.quantidade %>"
                required
              />
            </div>

            <div class="mb-3">
              <label for="descricao" class="form-label">Descrição</label>
              <textarea
                class="form-control"
                id="descricao"
                name="descricao"
                rows="3"
              >
<%= doacao.descricao || '' %></textarea
              >
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary-custom">
                Salvar alterações
              </button>

              <a
                href="<%= origemAdmin ? '/admin?aba=doacoes' : '/doacoes' %>"
                class="btn btn-secondary-custom"
              >
                Cancelar
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </body>
</html>
